#!/usr/bin/env python3
"""Dependency-free Evergreen command-line entry point."""

import argparse
import json
from pathlib import Path
import sys


sys.dont_write_bytecode = True
PLUGIN_ROOT = Path(__file__).resolve().parents[1]
if str(PLUGIN_ROOT) not in sys.path:
    sys.path.insert(0, str(PLUGIN_ROOT))

from evergreen.evidence import load_evidence  # noqa: E402
from evergreen.impact import impact  # noqa: E402


def error_display(value):
    rendered = ascii(str(value))
    return rendered if len(rendered) <= 512 else rendered[:508] + "...'"


def terminal_display(value, limit=4096):
    pieces = []
    used = 0
    for character in str(value):
        piece = character if character.isprintable() else character.encode(
            "unicode_escape", errors="backslashreplace"
        ).decode("ascii")
        if used + len(piece) > limit:
            pieces.append("...")
            break
        pieces.append(piece)
        used += len(piece)
    return "".join(pieces)


def parser():
    root = argparse.ArgumentParser(
        prog="evergreen",
        description="Evergreen candidate queries, receipts, and the second-provider judge the commands run.",
    )
    commands = root.add_subparsers(dest="command", required=True)
    query = commands.add_parser(
        "impact", help="find documentation candidates for changed paths and passive evidence"
    )
    query.add_argument("--repo", default=".", help="repository root (default: current directory)")
    query.add_argument("--evidence", help="passive evidence-provider JSON file")
    query.add_argument("--json", action="store_true", help="emit one JSON object")
    query.add_argument("paths", metavar="PATH", nargs="*", help="changed repository-relative path")
    query.set_defaults(run=run_impact)
    till = commands.add_parser(
        "till", help="inventory the public declaration surface reachable from outside each file"
    )
    till.add_argument("--repo", default=".", help="repository root (default: current directory)")
    till.add_argument("--json", action="store_true", help="emit one JSON object")
    till.add_argument(
        "paths", metavar="PATH", nargs="*",
        help="optional repository-relative scope prefix (default: whole repository)",
    )
    till.set_defaults(run=run_till)
    receipt = commands.add_parser("receipt", help="emit evidence-backed repository state")
    receipt.add_argument("--repo", default=".", help="path inside a Git repository")
    receipt.add_argument("--benchmark-manifest", help="Evergreen public benchmark manifest")
    receipt.add_argument("--json", action="store_true", help="emit one JSON object")
    receipt.set_defaults(run=run_receipt)
    judge = commands.add_parser(
        "judge",
        help="certify a document or a till inventory against the code, in isolated model calls",
    )
    judge.add_argument("--repo", required=True, help="repository the document describes")
    subject = judge.add_mutually_exclusive_group(required=True)
    subject.add_argument("--doc", help="document to certify")
    subject.add_argument("--inventory", help="`evergreen till --json` output to certify")
    judge.add_argument(
        "--rubric", choices=("doc", "cultivate"), default="doc",
        help="how to read --doc: prose claims (default) or a cultivate report of judgment rows",
    )
    judge.add_argument(
        "--timeout", type=int, default=300, help="seconds allowed for the call (default: 300)"
    )
    judge.add_argument("--json", action="store_true", help="emit the raw result object")
    judge.set_defaults(run=run_judge)
    return root


def run_judge(args):
    """Certify a document or an inventory against the repository code, with no network access.

    The prompt is built here rather than improvised by whatever agent typed the command: the
    rubric, the untrusted-data boundary, and the read bounds are the parts a judge call cannot
    be trusted to reinvent each time, and an abstain is a real answer (exit 3), not a failure
    to be retried by hand into a softer prompt.
    """
    try:
        from evergreen.judge import (
            CULTIVATE_RUBRIC, INVENTORY_RUBRIC, JUDGE_RUBRIC, collect_referenced_files,
            inventory_batches, inventory_text, judge_json, judge_prompt, judge_report,
            load_inventory,
        )
    except ImportError as error:                              # tomllib arrived in Python 3.11
        print(f"evergreen: judge requires Python 3.11 or later ({error_display(error)})", file=sys.stderr)
        return 2

    repo = Path(args.repo).expanduser()
    if not repo.is_dir():
        print(f"evergreen: repository must be a directory: {error_display(repo)}", file=sys.stderr)
        return 2
    if args.timeout <= 0:
        print("evergreen: --timeout must be a positive number of seconds", file=sys.stderr)
        return 2
    if args.inventory is not None and args.rubric != "doc":
        print("evergreen: --rubric applies to --doc, not --inventory", file=sys.stderr)
        return 2
    subject = Path(args.doc if args.inventory is None else args.inventory).expanduser()
    try:
        text = subject.read_text(encoding="utf-8", errors="replace")
    except (OSError, UnicodeError) as error:
        print(f"evergreen: {error_display(error)}", file=sys.stderr)
        return 2

    if args.inventory is not None:
        try:
            rows = load_inventory(text)
        except ValueError as error:
            print(f"evergreen: {error_display(error)}", file=sys.stderr)
            return 2
        batches, warnings = inventory_batches(repo.resolve(), rows)
        prompts = [
            (judge_prompt(
                f"INVENTORY batch {index} of {len(batches)}", inventory_text(batch_rows),
                files, INVENTORY_RUBRIC,
            ), len(files))
            for index, (files, batch_rows) in enumerate(batches, start=1)
        ]
        stage = "inventory"
    else:
        files, warnings = collect_referenced_files(repo.resolve(), text)
        rubric = CULTIVATE_RUBRIC if args.rubric == "cultivate" else JUDGE_RUBRIC
        prompts = [(judge_prompt(subject.name, text, files, rubric), 1)]
        stage = "report" if args.rubric == "cultivate" else "docs"
    for warning in warnings:
        print(f"evergreen: {terminal_display(warning)}", file=sys.stderr)

    # One abstaining call ends the run: the rest of the batches would only buy findings the
    # report is going to throw away. Nothing to call is an abstention too -- an inventory whose
    # files have all moved must not read as a clean sweep of a surface nobody judged.
    results = [] if prompts else [
        {"status": "abstain", "reason": "no source file from the inventory could be packed",
         "attempts": 0}
    ]
    for prompt, _count in prompts:
        results.append(judge_json(prompt, timeout=args.timeout))
        if results[-1]["status"] != "ok":
            break
    report = judge_report(stage, sum(count for _p, count in prompts), results, len(prompts))
    print_judge(report, args.json)
    return 0 if report["status"] == "ok" else 3


def print_judge(report, as_json):
    """The findings, then the one trailer line a run can paste verbatim."""
    if as_json:
        print(json.dumps(report, ensure_ascii=False, separators=(",", ":"), sort_keys=True))
        return
    if report["status"] == "ok":
        for finding in report["findings"]:
            print(
                f"{terminal_display(finding['verdict'])}  {terminal_display(finding['claim'])} "
                f"-- {terminal_display(finding['evidence'])}"
            )
        print(terminal_display(report["summary"]))
        print(
            f"judge: codex ok \u2014 docs {report['docs']}, certified {report['certified']}, "
            f"drift {report['drift']}, unverified {report['unverified']}"
        )
    else:
        print(
            f"evergreen: judge abstained: {terminal_display(report['reason'])}", file=sys.stderr
        )
        print(f"judge: abstain \u2014 {terminal_display(report['reason'])}")


def run_impact(args):
    repo = Path(args.repo).expanduser()
    if not repo.is_dir():
        print(f"evergreen: repository must be a directory: {error_display(repo)}", file=sys.stderr)
        return 2
    repo = repo.resolve()

    evidence = []
    warnings = []
    if args.evidence is not None:
        evidence, evidence_warnings = load_evidence(Path(args.evidence), repo)
        warnings.extend(evidence_warnings)
    report = impact(repo, args.paths, evidence)
    warnings.extend(report.warnings)
    warnings = sorted(set(warnings))
    payload = {
        "schema_version": 1,
        "candidates": [
            {"path": item.path, "rank": item.rank, "reasons": list(item.reasons)}
            for item in report.candidates
        ],
        "warnings": warnings,
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, separators=(",", ":"), sort_keys=True))
    else:
        print_human(payload)
    return 0


def run_till(args):
    from evergreen.till import till
    repo = Path(args.repo).expanduser()
    if not repo.is_dir():
        print(f"evergreen: repository must be a directory: {error_display(repo)}", file=sys.stderr)
        return 2
    try:
        report = till(repo.resolve(), tuple(args.paths))
    except ValueError as error:
        print(f"evergreen: {error_display(error)}", file=sys.stderr)
        return 2
    payload = {
        "schema_version": 1,
        "candidates": [
            {"symbol": c.symbol, "kind": c.kind, "path": c.path, "line": c.line, "rank": c.rank}
            for c in report.candidates
        ],
        "source_files_in_scope": report.source_files_in_scope,
        "source_files_scanned": report.source_files_scanned,
        "warnings": list(report.warnings),
    }
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, separators=(",", ":"), sort_keys=True))
    else:
        print_till(payload)
    return 0


def run_receipt(args):
    from evergreen.receipt import ReceiptError, ReceiptOperationalError, build_receipt

    try:
        repo = Path(args.repo).expanduser()
        benchmark_manifest = (
            None
            if args.benchmark_manifest is None
            else Path(args.benchmark_manifest).expanduser()
        )
    except (OSError, RuntimeError) as error:
        print(f"evergreen: {error_display(error)}", file=sys.stderr)
        return 2
    try:
        payload = build_receipt(repo, benchmark_manifest)
    except ReceiptOperationalError as error:
        print(f"evergreen: {error_display(error)}", file=sys.stderr)
        return 1
    except ReceiptError as error:
        print(f"evergreen: {error_display(error)}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, separators=(",", ":"), sort_keys=True))
    else:
        print_receipt(payload)
    return 0


def print_receipt(payload):
    repository = payload["repository"]
    print("Repository receipt:")
    print(f"- root: {terminal_display(repository['root'])}")
    print(f"- name: {terminal_display(repository['name'])}")
    print("- origin: " + (
        "none" if repository["origin"] is None else terminal_display(repository["origin"])
    ))
    print("- branch: " + (
        "detached" if repository["branch"] is None else terminal_display(repository["branch"])
    ))
    print(f"- HEAD: {terminal_display(repository['head'])}")
    print("- upstream: " + (
        "none" if repository["upstream"] is None else terminal_display(repository["upstream"])
    ))
    ahead_behind = (
        "unknown"
        if repository["ahead"] is None or repository["behind"] is None
        else f"{repository['ahead']}/{repository['behind']}"
    )
    print(f"- ahead/behind: {ahead_behind}")
    print(
        f"- changes: staged={repository['staged']} "
        f"unstaged={repository['unstaged']} untracked={repository['untracked']}"
    )
    print(f"- clean: {str(repository['clean']).lower()}")

    release = payload["release"]
    tags = "none" if not release["local_tags"] else terminal_display(
        ",".join(release["local_tags"])
    )
    print("Release evidence:")
    print(f"- local tags at HEAD: {tags}")
    print(f"- external state: {terminal_display(release['external_state'])}")

    benchmark = payload["benchmark"]
    print("Benchmark evidence:")
    if benchmark is None:
        print("- none")
        return
    print(f"- artifact count: {benchmark['artifact_count']}")
    print(f"- evaluated release: {terminal_display(benchmark['evaluated_release'])}")
    print(f"- evidence state: {terminal_display(benchmark['evidence_state'])}")
    print(f"- judge SHA-256: {terminal_display(benchmark['judge_sha256'])}")
    print(f"- languages: {terminal_display(','.join(benchmark['languages']))}")
    datasets = benchmark["local_datasets"]
    print(f"- local datasets: present={datasets['present']} absent={datasets['absent']}")
    print(f"- manifest: {terminal_display(benchmark['manifest'])}")
    print(f"- protocol: {terminal_display(benchmark['protocol'])}")
    print(f"- provenance commit: {terminal_display(benchmark['provenance_commit'])}")
    print(f"- provider: {terminal_display(benchmark['provider'])}")
    print(f"- report: {terminal_display(benchmark['report'])}")
    print(f"- resolver: {terminal_display(benchmark['resolver'])}")


def print_human(payload):
    candidates = payload["candidates"]
    print(f"Candidates ({len(candidates)}):")
    if not candidates:
        print("- none")
    for candidate in candidates:
        print(f"- [{candidate['rank']}] {terminal_display(candidate['path'])}")
        for reason in candidate["reasons"]:
            print(f"  reason: {terminal_display(reason)}")
    print_warnings(payload)


def print_till(payload):
    candidates = payload["candidates"]
    print(f"Candidates ({len(candidates)}):")
    if not candidates:
        print("- none")
    for candidate in candidates:
        print(
            f"- [{candidate['rank']}] {terminal_display(candidate['symbol'])} "
            f"({terminal_display(candidate['kind'])}) "
            f"{terminal_display(candidate['path'])}:{candidate['line']}"
        )
    print(
        f"Source files: scanned {payload['source_files_scanned']} "
        f"of {payload['source_files_in_scope']} in scope"
    )
    print_warnings(payload)


def print_warnings(payload):
    warnings = payload["warnings"]
    if warnings:
        print(f"Warnings ({len(warnings)}):")
        for warning in warnings:
            print(f"- {terminal_display(warning)}")


def main(argv=None):
    arguments = parser().parse_args(argv)
    try:
        return arguments.run(arguments)
    except (OSError, UnicodeError) as error:
        print(f"evergreen: {error_display(error)}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
